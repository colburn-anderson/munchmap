# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview), then redeploy.

# Required. Google Cloud key with "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=

# Optional. Enables AI query interpretation ("cheap late-night tacos in Midtown").
# Without it, search still works using the filter chips.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
